---
import LinkedReadout from './LinkedReadout.astro';
import data from '../data/profiles.json';
import palette from '../data/paper-palette.json';
const methods = [
  { name: 'Measured', color: palette.gray }, { name: 'Fixed', color: palette.gray },
  { name: 'Normal', color: palette.rose }, { name: 'IID', color: palette.blue },
  { name: 'Temporal', color: palette.purple },
];
const bins = data.edges.slice(0, -1).map((edge, index) => ({ edge, index })).filter(({ edge }) => edge < 100 && edge + 2 > 45);
const x = (value: number) => 38 + (value - 45) / 55 * 156;
const y = (value: number) => 174 - value / data.densityMax * 164;
const outline = bins.map(({ edge, index }) => `${x(Math.max(45, edge))},${y(data.counts[0][index] / data.count / 2)} ${x(Math.min(100, edge + 2))},${y(data.counts[0][index] / data.count / 2)}`).join(' ');
---
<figure id="profiles-figure" data-linked-figure data-source={'/lagen/' + 'assets/data/profiles.json'} aria-label="Measured and generated latency sequences and distributions">
  <div class="profiles-panels" data-choice-group>
    {methods.map((method, column) => <section class="profile-panel" data-profile-column={column} style={{ '--profile-color': method.color }}>
      <h5><button type="button" data-choice={'method:' + column} aria-pressed="false" aria-describedby="profiles-figure-help">{method.name}</button></h5>
      <p class="profile-axis-title">Action latency (ms)</p>
      <div class="profile-sequence">
        <canvas aria-hidden="true" data-sequence={column}></canvas>
        <svg viewBox="0 0 200 230" role="img" aria-label={method.name + ': 24,225 requests in order; circles are worker 0 and squares worker 1'}>
          {[50, 75, 100].map(value => <g><line x1="38" x2="194" y1={10 + (100 - value) / 55 * 164} y2={10 + (100 - value) / 55 * 164} class="linked-grid" /><text x="32" y={15 + (100 - value) / 55 * 164} text-anchor="end">{value}</text></g>)}
          <path d="M38 10V174H194" class="linked-axis" />
          {[0, 10000, 20000].map(value => <text x={38 + (value + 300) / (data.count - 1 + 600) * 156} y="196" text-anchor="middle">{value === 0 ? '0' : value / 1000 + 'k'}</text>)}
          <text x="116" y="222" text-anchor="middle">Request index</text>
        </svg>
      </div>
      <p class="profile-axis-title">Density (ms⁻¹)</p>
      <svg class="profile-histogram" viewBox="0 0 200 230" data-choice-group data-roving aria-label={method.name + ' latency distribution'}>
        {[0, .25, .5].map(value => <g><line x1="38" x2="194" y1={y(value)} y2={y(value)} class="linked-grid" /><text x="32" y={y(value) + 5} text-anchor="end">{value === 0 ? '0' : value === .25 ? '.25' : '.5'}</text></g>)}
        <g class="profile-bars" fill={method.color}>
          {bins.map(({ edge, index }) => <rect data-bin-bar={index} x={x(Math.max(45, edge))} y={y(data.counts[column][index] / data.count / 2)} width={x(Math.min(100, edge + 2)) - x(Math.max(45, edge))} height={174 - y(data.counts[column][index] / data.count / 2)} opacity=".6" />)}
        </g>
        <polyline points={outline} class="linked-reference" />
        <path d="M38 10V174H194" class="linked-axis" />
        {[50, 75, 100].map(value => <text x={x(value)} y="196" text-anchor={value === 100 ? 'end' : 'middle'}>{value}</text>)}
        <text x="116" y="222" text-anchor="middle">Latency (ms)</text>
        {bins.map(({ edge, index }, i) => <g data-choice={'bin:' + index} data-readout={'profile-bin-' + index} role="button" tabindex={i === 0 ? 0 : -1} aria-pressed="false" aria-label={`${method.name}: highlight requests from ${edge} to ${edge + 2} ms`} aria-describedby="profiles-figure-help">
          <rect class="profile-bin-hit" x={x(Math.max(45, edge))} y="10" width={x(Math.min(100, edge + 2)) - x(Math.max(45, edge))} height="164" />
        </g>)}
      </svg>
    </section>)}
  </div>
  <div class="if-legend profile-legend"><span>● Worker 0</span><span>■ Worker 1</span><span><svg viewBox="0 0 22 16" aria-hidden="true"><path d="M0 8H22" class="linked-reference" /></svg>Measured distribution</span></div>
  {bins.map(({ edge, index }) => <template id={'profile-bin-' + index}>
    <p class="readout-title">{edge} ≤ latency &lt; {edge + 2} ms</p>
    <p class="readout-subtitle">Requests out of {data.count.toLocaleString('en-US')} per sequence</p>
    <dl>{methods.map((method, column) => <><dt>{method.name}</dt><dd>{data.counts[column][index].toLocaleString('en-US')}</dd></>)}</dl>
  </template>)}
  <LinkedReadout id="profiles-figure" />
  <figcaption>Measured latency and sequences generated by four fitted models. Select a latency range to highlight matching requests across all five sequences. The displayed range is 45–100 ms. Distributions use the full sequences.</figcaption>
</figure>
<script>import '../scripts/profiles';</script>
<style>
  .profiles-panels { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  .profile-panel { min-width: 0; }
  h5 { margin: 0 0 16px; text-align: center; }
  h5 button { border: 0; background: transparent; padding: 7px 12px; border-radius: 6px; font-size: 18px; font-weight: 600; }
  h5 button.is-active { background: color-mix(in srgb, var(--profile-color) 12%, white); color: var(--profile-color); box-shadow: 0 2px 5px #2926311a; }
  .profile-axis-title { font-size: 16px; margin: 10px 0 8px; text-align: center; }
  .profile-sequence { position: relative; }
  .profile-sequence svg, .profile-histogram { width: 100%; display: block; overflow: visible; }
  canvas { position: absolute; left: 19%; top: 4.347826%; width: 78%; height: 71.304348%; }
  .profile-bin-hit { fill: transparent; }
  [data-choice].is-active .profile-bin-hit { fill: #355070; fill-opacity: .1; stroke: #355070; stroke-width: 1; }
  .profile-legend { margin-top: 22px; }
  @container (max-width: 1055px) {
    .profiles-panels { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px; }
    .profile-panel { max-width: 320px; width: 100%; justify-self: center; }
    .profile-panel svg text { font-size: 16px; }
  }
  @container (max-width: 600px) {
    .profiles-panels { grid-template-columns: minmax(0, 1fr); }
  }
</style>
