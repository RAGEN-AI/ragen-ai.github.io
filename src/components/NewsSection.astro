---
// NewsSection.astro - In the News: press and media coverage of RAGEN / RAGEN-2
const news = [
  { date: "2026-07", outlet: "Nebius Science", title: "ICML 2026: Papers That Matter", url: "https://nebius.science/stories/icml-papers-that-matter", note: "RAGEN-2 selected among the 20 papers that matter at ICML 2026" },
  { date: "2026-06", outlet: "Northwestern Engineering", title: "Northwestern Computer Science at CVPR 2026", url: "https://www.mccormick.northwestern.edu/computer-science/news-events/news/articles/2026/northwestern-computer-science-at-cvpr-2026.html", note: "RAGEN-2 wins Best Paper Award at the CVPR 2026 MMRAgI workshop" },
  { date: "2026-06", outlet: "Turing Post", title: "Agent RL Training Frameworks: 10 Open-Source Tools to Know", url: "https://www.turingpost.com/p/agent-rl-training-tools", note: "RAGEN featured among the top open-source agent RL frameworks" },
  { date: "2026-04", outlet: "Z Potentials", title: "Z Tech｜对话王子涵：离开DeepSeek，我人生的逆向思考", url: "https://www.sohu.com/a/1014469485_122063396", note: "interview with first author Zihan Wang on RAGEN and RAGEN-2" },
  { date: "2026-04", outlet: "图灵人工智能 (via Sina Finance)", title: "从熵到互信息，RAGEN-2重塑推理质量标准，让AI Agent不再“越训越模板化”", url: "https://finance.sina.com.cn/wm/2026-04-13/doc-inhuiatm9881223.shtml", note: "deep dive into RAGEN-2's template-collapse diagnosis" },
  { date: "2025-06", outlet: "Lambda", title: "Partner Spotlight: Orchestrating Large-Scale Agent Training on Lambda with dstack and RAGEN", url: "https://lambda.ai/blog/agent-training-on-lambda-with-dstack-and-ragen", note: "scaling RAGEN multi-turn RL training on GPU clusters" },
  { date: "2025-05", outlet: "Northwestern Engineering", title: "Training Reasoning Agents in Interactive, Complex Environments", url: "https://www.mccormick.northwestern.edu/computer-science/news-events/news/articles/2025/training-reasoning-agents-in-interactive-complex-environments.html", note: "university feature on StarPO and RAGEN" },
  { date: "2025-05", outlet: "MarkTechPost", title: "Training LLM Agents Just Got More Stable: Researchers Introduce StarPO-S and RAGEN", url: "https://www.marktechpost.com/2025/05/01/training-llm-agents-just-got-more-stable-researchers-introduce-starpo-s-and-ragen-to-tackle-multi-turn-reasoning-and-collapse-in-reinforcement-learning/", note: "on StarPO-S stabilization against Echo Trap collapse" },
  { date: "2025-04", outlet: "VentureBeat", title: "Former DeepSeeker and Collaborators Release New Method for Training Reliable AI Agents: RAGEN", url: "https://venturebeat.com/ai/former-deepseeker-and-collaborators-release-new-method-for-training-reliable-ai-agents-ragen", note: "feature on RAGEN and StarPO-S" },
  { date: "2025-04", outlet: "AI News", title: "RAGEN: AI Framework Tackles LLM Agent Instability", url: "https://www.artificialintelligence-news.com/news/ragen-ai-framework-tackles-llm-agent-instability/", note: "on the Echo Trap finding and StarPO-S" },
  { date: "2025-04", outlet: "DeepTech深科技 (MIT Technology Review China)", title: "李飞飞等领衔，来自七所高校的“三代AI人”联合提出强化学习新框架", url: "https://www.mittrchina.com/news/detail/14715", note: "in-depth feature with team interviews" },
  { date: "2025-04", outlet: "量子位 QbitAI", title: "李飞飞/DeepSeek前员工领衔，复现R1强化学习框架，训练Agent在行动中深度思考", url: "https://www.thepaper.cn/newsDetail_forward_30719867", note: "report on RAGEN, StarPO, and the Echo Trap" },
  { date: "2025-04", outlet: "腾讯新闻", title: "AI智能体老“崩”？DeepSeek前员工联手李飞飞等大佬开源新框架", url: "https://news.qq.com/rain/a/20250424A03M2700", note: "news feature on the open-source release" },
  { date: "2025-04", outlet: "Business Leaders Review", title: "RAGEN & StarPO Aim to Tame LLM Instability in Complex Tasks", url: "https://businessleadersreview.com/ragen-starpo-aim-to-tame-llm-instability-in-complex-tasks/", note: "business-audience coverage" },
  { date: "2025-04", outlet: "OpenTools AI News", title: "RAGEN Revolutionizes AI Training by Tackling the 'Echo Trap'", url: "https://opentools.ai/news/ragen-revolutionizes-ai-training-by-tackling-the-echo-trap", note: "explainer on StarPO and StarPO-S mechanics" },
  { date: "2025-04", outlet: "Innovatopia (Japan)", title: "RAGEN：元DeepSeek研究者らが開発した信頼性の高いAIエージェント訓練の新手法", url: "https://innovatopia.jp/ai/ai-news/52472/", note: "Japanese coverage of RAGEN and StarPO" },
  { date: "2025-01", outlet: "MarkTechPost", title: "Meet RAGEN Framework: The First Open-Source Reproduction of DeepSeek-R1 for Training Agentic Models via Reinforcement Learning", url: "https://www.marktechpost.com/2025/01/31/meet-ragen-framework-the-first-open-source-reproduction-of-deepseek-r1-for-training-agentic-models-via-reinforcement-learning/", note: "coverage of the initial RAGEN release" },
  { date: "", outlet: "Arize AI", title: "What Is RAGEN?", url: "https://arize.com/glossary/ragen-llm-agent-training-system/", note: "glossary entry on RAGEN's multi-turn trajectory-level RL" },
  { date: "", outlet: "AI工具集", title: "RAGEN：训练大模型推理Agent的开源强化学习框架", url: "https://ai-bot.cn/ragen/", note: "Chinese profile of the framework" },
];
---
<section id="news" class="content-section">
  <div class="section-container">
    <h2 class="section-title">In the News</h2>
    <ul class="news-list">
      {news.map((n) => (
        <li class="news-item">
          <span class="news-date">{n.date || " "}</span>
          <span class="news-body">
            <span class="news-outlet">{n.outlet}</span>
            <a class="news-link" href={n.url} target="_blank" rel="noopener noreferrer">{n.title}</a>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .news-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .news-item {
    display: flex;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    align-items: baseline;
  }
  .news-item:last-child {
    border-bottom: none;
  }
  .news-date {
    flex: 0 0 4.5rem;
    font-size: 0.85rem;
    color: #888;
    font-variant-numeric: tabular-nums;
  }
  .news-outlet {
    font-weight: 600;
    margin-right: 0.5rem;
  }
  .news-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(74, 86, 201, 0.35);
  }
  .news-link:hover {
    color: #4a56c9;
    border-bottom-color: #4a56c9;
  }
</style>
