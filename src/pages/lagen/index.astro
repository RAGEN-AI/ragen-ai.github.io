---
import Layout from '../../lagen/layouts/Layout.astro';
import FailureDemo from '../../lagen/components/FailureDemo.astro';
import ProfilesFigure from '../../lagen/components/ProfilesFigure.astro';
import PipelineFigure from '../../lagen/components/PipelineFigure.astro';
import HistoryFigure from '../../lagen/components/HistoryFigure.astro';
import DegradationFigure from '../../lagen/components/DegradationFigure.astro';
import RecoveryFigure from '../../lagen/components/RecoveryFigure.astro';
import LatencyApproachesFigure from '../../lagen/components/LatencyApproachesFigure.astro';
import CrossTaskFigure from '../../lagen/components/CrossTaskFigure.astro';
import CalibrationFigure from '../../lagen/components/CalibrationFigure.astro';
import RobustnessFigure from '../../lagen/components/RobustnessFigure.astro';
import MobileCollapse from '../../lagen/components/MobileCollapse.astro';
import CoreResultsTable from '../../lagen/components/CoreResultsTable.astro';
import CodingAgentResults from '../../lagen/components/CodingAgentResults.astro';
import meanTraining from '../../lagen/data/mean-training.json';
import prompt from '../../lagen/data/prompt.json';
const asset = (name: string) => '/lagen/' + 'assets/' + name;
const title = 'Are Vision-Language Agents Latency Aware?';
const authors = [
  ['Talha Chafekar', '1,2,*,†', 'https://github.com/talha1503'],
  ['Zihan "Zenus" Wang', '1,*', 'https://zihanwang314.github.io/'],
  ['Zeju Li', '1,*,†', 'https://zeju-li.com/'],
  ['Xinyuan Li', '1,*,†', 'https://mindorigin150.github.io/'],
  ['Qineng Wang', '1', 'https://qinengwang-aiden.github.io/'],
  ['Jiajun Wu', '3', 'https://jiajunwu.com/'],
  ['Yuke Zhu', '4,5', 'https://yukezhu.me/'],
  ['Yi Dong', '5', 'https://yidong72.github.io/'],
  ['Zhiding Yu', '5', 'https://chrisding.github.io/'],
  ['Ruohan Zhang', '1,3', 'https://ruohanzhang.com/'],
  ['Manling Li', '1', 'https://limanling.github.io/'],
];
const citation = '@misc{chafekar2026lagen,\n  title={LAGEN: Are Vision-Language Agents Latency Aware?},\n  author={Talha Chafekar and Zihan Wang and Zeju Li and Xinyuan Li and Qineng Wang and Jiajun Wu and Yuke Zhu and Yi Dong and Zhiding Yu and Ruohan Zhang and Manling Li},\n  year={2026}\n}';
const pageTitle = 'LAGEN: Are Vision-Language Agents Latency Aware?';
const pageDescription = 'Latency-aware VLA agents: in real time, VLA policies keep a median 6.6% of zero-latency return; training with profiled deployment latency improves all 36 task-architecture pairs.';
const pageUrl = 'https://ragen-ai.github.io/lagen/';
const pdfUrl = 'https://ragen-ai.github.io/lagen/assets/paper.pdf';
const keywords = ['LAGEN', 'latency-aware agents', 'latency-aware VLA', 'vision-language-action', 'VLA latency', 'action latency', 'inference latency', 'real-time VLA evaluation', 'latency-aware training', 'latency profiling', 'deployment latency', 'OpenVLA', 'pi0.5', 'GR00T'];
const faq = [
  ['What is action latency for vision-language-action (VLA) agents?', 'While a VLA policy computes its next action, the environment keeps changing, so the action is executed in a state that has already moved on. Current benchmarks hide this by pausing the environment during inference. Evaluated in real time on an RTX 3090 GPU, VLA policies on 12 environments retain a median of only 6.6% of their zero-latency return.'],
  ['Does faster inference solve the latency problem?', 'No. Faster inference reduces the delay but does not eliminate it, and training with a delay chosen in advance may not match the target deployment. LAGEN instead keeps the residual latency and trains the agent to act with it.'],
  ['How does LAGEN train latency-aware agents?', 'LAGEN measures latency on the target hardware, fits a latency profile that models which delays occur and whether large delays occur on consecutive requests, and replays new delay sequences in simulation. A small RL teacher is trained under the replayed latency and distilled into three VLA architectures (OpenVLA, pi0.5, and GR00T). Training under the target profile improves hardware-timed return in all 36 task-architecture pairs, by 16% to 86% of zero-latency return.'],
  ['Does latency training transfer across different delays?', 'Only partly: transfer is asymmetric and task-dependent. On Demon Attack, a policy trained at 16 frames of delay retains 85% of the same-delay reference at 8 frames, whereas the reverse retains only 27%. An explicit latency value in the prompt can be essential when training across delays, while the benefit of visual history depends on the task.'],
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ScholarlyArticle',
      '@id': pageUrl + '#paper',
      'headline': pageTitle,
      'name': pageTitle,
      'alternateName': ['Are Vision-Language Agents Latency Aware?', 'LAGEN: Latency-Aware Agents'],
      'url': pageUrl,
      'encoding': { '@type': 'MediaObject', 'contentUrl': pdfUrl, 'encodingFormat': 'application/pdf' },
      'datePublished': '2026-10',
      'abstract': 'Foundation-model agents, such as vision-language-action (VLA) policies, suffer from action latency: the environment keeps changing while the policy computes. Faster inference reduces this delay but does not eliminate it, and training with a delay chosen in advance may not match the target deployment. Current benchmarks hide the problem by pausing the environment during inference; evaluated in real time on an RTX 3090 GPU, VLA policies on 12 environments retain a median of only 6.6% of their zero-latency return. We introduce a latency profiling and replay framework that models which delays occur and whether large delays occur on consecutive requests, then replays new delay sequences in simulation.',
      'keywords': keywords,
      'author': authors.map(([name]) =>
        name === 'Manling Li'
          ? { '@type': 'Person', '@id': 'https://limanling.github.io/#person', 'name': 'Manling Li', 'url': 'https://limanling.github.io/' }
          : { '@type': 'Person', 'name': name.replace(' "Zenus"', '') }),
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': pageUrl + '#code',
      'name': 'LAGEN',
      'codeRepository': 'https://github.com/mll-lab-nu/latency-aware-agents',
      'programmingLanguage': 'Python',
      'description': 'Code for latency profiling, latency replay in simulation, and latency-aware training of vision-language-action agents.',
    },
    {
      '@type': 'Dataset',
      '@id': pageUrl + '#dataset',
      'name': 'LAGEN datasets and latency profiles',
      'description': 'Training data and measured GPU latency profiles for latency-aware vision-language-action agents.',
      'url': pageUrl,
      'sameAs': ['https://huggingface.co/datasets/MLL-Lab/LAGEN-datasets', 'https://huggingface.co/datasets/MLL-Lab/LAGEN-profiles', 'https://huggingface.co/MLL-Lab/LAGEN-models'],
      'creator': { '@type': 'Organization', 'name': 'MLL Lab, Northwestern University', 'url': 'https://mll-lab-nu.github.io' },
    },
    {
      '@type': 'FAQPage',
      '@id': pageUrl + '#faq',
      'mainEntity': faq.map(([q, a]) => ({ '@type': 'Question', 'name': q, 'acceptedAnswer': { '@type': 'Answer', 'text': a } })),
    },
  ],
};

---
<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="citation_title" content={pageTitle} />
    {authors.map(([name]) => <meta name="citation_author" content={name.replace(' "Zenus"', '')} />)}
    <meta name="citation_publication_date" content="2026/10" />
    <meta name="citation_pdf_url" content={pdfUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <script is:inline>
    // Hide the hero title until the intro script splits it; the timeout shows it if the script fails.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('lagen-intro');
      setTimeout(() => document.documentElement.classList.add('lagen-intro-ready'), 2500);
    }
  </script>
  <section class="hero" aria-labelledby="paper-title">
    <div class="section-width">
      <div class="hero-brand">
        <img src={asset('logo.svg')} alt="LAGEN" width="105" height="90" />
        <h1 id="paper-title">{title}</h1>
      </div>
      <p class="hero-lead">Training agents for a world that keeps moving</p>
      <div class="authors" aria-label="Paper authors">
        {authors.map(([name, note, url]) => <span><a href={url} target="_blank" rel="noopener">{name}</a><sup>{note}</sup></span>)}
      </div>
      <p class="author-notes"><sup>*</sup> Equal contribution; author order is interchangeable.<br /><sup>†</sup> Work done during internship at Northwestern.</p>
      <p class="affiliations">
        <span><sup>1</sup> Northwestern</span><span><sup>2</sup> UMass Amherst</span><span><sup>3</sup> Stanford</span><span><sup>4</sup> UT Austin</span><span><sup>5</sup> NVIDIA</span>
      </p>
      <p class="hero-abstract">While a VLA agent calculates an action, the environment continues to move. When the action starts, the state is already different. On an RTX&nbsp;3090 in real time, the median return of 36 VLA policies is only <strong>6.6%</strong> of their return without latency. LAGEN measures the latency of a deployment and trains agents to act correctly with it.</p>
      <div class="resource-links">
        <a class="button primary" href={asset('paper.pdf')} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8Z"/><path d="M14 3v5h5M8 12h8M8 16h8"/></svg>Paper</a>
        <a class="button" href="https://github.com/mll-lab-nu/latency-aware-agents" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.768-.244.768-.542 0-.267-.01-.975-.015-1.914-3.13.68-3.791-1.508-3.791-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.699.078-.685.078-.685 1.13.079 1.725 1.16 1.725 1.16 1.005 1.723 2.637 1.225 3.279.937.102-.729.393-1.225.715-1.507-2.5-.284-5.126-1.25-5.126-5.56 0-1.229.439-2.233 1.16-3.02-.117-.284-.503-1.43.11-2.978 0 0 .945-.303 3.094 1.154A10.782 10.782 0 0 1 12 6.185c.956.004 1.918.129 2.816.379 2.147-1.457 3.09-1.154 3.09-1.154.615 1.548.229 2.694.113 2.978.722.787 1.158 1.791 1.158 3.02 0 4.32-2.63 5.272-5.137 5.55.404.35.764 1.042.764 2.1 0 1.517-.014 2.741-.014 3.113 0 .3.203.651.774.54A11.252 11.252 0 0 0 12 .75Z"/></svg>Code</a>
        <a class="button" href="https://huggingface.co/MLL-Lab/LAGEN-models" target="_blank" rel="noopener"><img src={asset('huggingface.svg')} alt="" width="21" height="21" />Models</a>
        <a class="button" href="https://huggingface.co/datasets/MLL-Lab/LAGEN-datasets" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/></svg>Data</a>
        <a class="button" href="https://huggingface.co/datasets/MLL-Lab/LAGEN-profiles" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/></svg>Profiles</a>
        <a class="button" href="#citation"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M9 4H6a1 1 0 0 0-1 1v15a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-3"/><rect x="9" y="2" width="6" height="4" rx="1"/></svg>Citation</a>
      </div>
    </div>
  </section>
  <section id="video" class="section-width video-section" aria-label="Summary video">
    <video id="lagen-video" controls muted preload="metadata" playsinline poster={asset('video/poster.jpg')}>
      <source src={asset('video/lagen.mp4')} type="video/mp4" />
    </video>
    <script is:inline>
      // Start playing (muted, as browsers require) the first time the video is mostly on screen.
      (function () {
        var v = document.getElementById('lagen-video');
        if (!v || !('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(function (entries) {
          if (!entries[0].isIntersecting) return;
          io.disconnect();
          var p = v.play();
          if (p && p.catch) p.catch(function () {});
        }, { threshold: 0.6 });
        io.observe(v);
      })();
    </script>
  </section>
  <section id="demo" aria-labelledby="demo-title">
    <FailureDemo />

    <section id="problem" class="paper-section section-width">
      <h2>Evaluation that stops the environment hides the effect of latency</h2>
      <p class="section-lead">This failure is not specific to one episode. On Flappy Bird and Demon Attack, we add a delay of only two frames. The return then falls to <strong>1.2–7.1% of the return without delay.</strong></p>
      <DegradationFigure />
    </section>

  </section>

  <section id="results" class="paper-section section-width">
    <h2>Faster inference does not remove latency. Train with latency.</h2>
    <p class="section-lead">Faster inference makes the latency smaller, but the latency does not become zero. Thus, we keep the latency and train the agent to act with it.</p>
    <LatencyApproachesFigure />
    <p class="section-lead">Result: training with latency increases the real-time return for <strong>all 36 combinations of task and model</strong>.</p>
    <MobileCollapse summary="Show results for all 12 tasks"><RecoveryFigure /></MobileCollapse>
    <CoreResultsTable />
    <CodingAgentResults />
    <p class="bridge">How do we train with latency? First, we make a model of the deployment latency. Then, we train the agent with this model. <a href="#method">See the method</a>.</p>
  </section>

  <section id="method" class="paper-section section-width" aria-label="Method">
    <section id="profiling" class="research-group">
      <h2>Simulate the deployment latency</h2>
      <p class="section-lead">First, we find the latency that the agent will have during deployment. We measure the latency on the target hardware and fit a latency profile to the measurements. Then, we use the profile to make new latency sequences in simulation.</p>
      <section id="latency-bursts" class="evidence">
        <h3>Slow requests occur in groups</h3>
        <p>Two deployments can have the same mean latency but different sequences of latency. Only the Temporal profile shows that slow requests occur together in time.</p>
        <MobileCollapse summary="Show the latency profiles"><ProfilesFigure /></MobileCollapse>
      </section>
      <section id="calibration" class="evidence">
        <h3>The latency simulation predicts the return on real hardware</h3>
        <p>Does the latency simulation predict the return on real hardware? With the Temporal profile, the prediction error decreases from <strong>8.93 to 3.81 percentage points</strong>. The baseline is a fixed latency that is equal to the mean.</p>
        <MobileCollapse summary="Show simulated and real returns"><CalibrationFigure /></MobileCollapse>
        <details>
          <summary>How we test the latency simulation</summary>
          <p>We evaluate OpenVLA and GR00T on three tasks: Flappy Bird, Inverted Pendulum, and Intercept Grab (Fast). We use five GPU types: RTX 3090, RTX 4090, RTX 5090, L40S, and A100.</p>
          <p>For each combination, we use 25 runs to fit the latency model and 25 different runs to evaluate it. Each run has two episodes. The latency simulation includes both action delay and inference capacity.</p>
          <p>Normalized return error for all combinations, in percentage points: Fixed 8.93, Normal 6.55, IID 4.58, Temporal 3.81. Refer to paper §3.4.</p>
        </details>
      </section>
    </section>
    <section id="pipeline" class="research-group">
      <h2>Train agents with the deployment latency</h2>
      <p class="section-lead">Then, we train the agent with the profile. First, an RL teacher learns to act with the simulated latency. Then, the VLA learns from the actions of the teacher.</p>
      <PipelineFigure />
    </section>
  </section>

  <section id="findings" class="paper-section section-width" aria-label="Experiments">
    <h2>Three questions about latency training</h2>
    <p class="section-lead">What must we train with? How well does the training transfer? What information does the agent need?</p>
    <div id="training-findings" class="findings-group">
      <section id="training" class="evidence">
        <h3>1. Training with the full profile gives a higher return</h3>
        <p>Is the mean latency sufficient for training? No. Training with the full profile gives a higher return on three of four tasks. On Flappy Bird, the two returns are almost equal.</p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Mean-delay and profile training comparison">
          <table class="comparison-table">
            <caption>OpenVLA with one action for each request. The values are mean episode returns.</caption>
            <thead><tr><th>Training</th>{meanTraining.map(row => <th>{row.task}</th>)}</tr></thead>
            <tbody>
              <tr><th scope="row">Fixed mean</th>{meanTraining.map(row => <td><strong class:list={{winner: row.mean > row.profile}}>{row.mean.toFixed(2)}</strong></td>)}</tr>
              <tr><th scope="row">Full profile</th>{meanTraining.map(row => <td><strong class:list={{winner: row.profile > row.mean}}>{row.profile.toFixed(2)}</strong></td>)}</tr>
              <tr class="gain-row"><th scope="row">Profile gain</th>{meanTraining.map(row => <td>{row.gain > 0 ? '+' : ''}{row.gain.toFixed(1)}%</td>)}</tr>
            </tbody>
          </table>
        </div>
      </section>

      <section id="transfer" class="evidence">
          <h3>2. Transfer from high to low latency is better than from low to high latency</h3>
          <p>Does a policy work at a latency that is different from its training latency? Transfer from high to low latency is better than transfer from low to high latency. On Flappy Bird, a policy works well only near its training latency.</p>
          <RobustnessFigure />
      </section>
      <section id="cross-task" class="evidence">
          <h3>3. Latency training can help on other tasks</h3>
          <p>Does the training help on other tasks? We train a policy on Demon Attack with mixed latencies. On Atlantis and AirRaid, this policy gets a higher return than a policy trained without latency. On Asterix, the result is mixed.</p>
          <CrossTaskFigure />
      </section>
    </div>

    <div id="information" class="findings-group">
      <section id="latency-prompt" class="evidence">
        <h3>4. The latency value in the prompt increases the return</h3>
        <p>At different latencies, the same frame can need different actions. When the prompt gives the latency value, the Flappy Bird return increases from <strong>less than 20 to 268–434</strong>.</p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Latency prompt ablation across three tasks">
          <table class="prompt-table">
            <caption>Games: mean return. Intercept Grab: success rate (%). Each condition uses 20 episodes.</caption>
            <thead><tr><th>Task</th><th>Delay in prompt</th>{[0,1,2,3,4].map(n => <th>{n} {n === 1 ? 'frame' : 'frames'}</th>)}</tr></thead>
            <tbody>{prompt.map(row => <tr class:list={{'with-prompt': row.withLatency}}><th scope="row">{row.task}</th><td>{row.withLatency ? 'Yes' : 'No'}</td>{row.cells.map(cell => <td><strong>{cell.mean.toFixed(1)}{row.metric === 'success_rate_percent' ? '%' : ''}</strong></td>)}</tr>)}</tbody>
          </table>
        </div>
        <p class="figure-note">In each column, the prompt gives the delay of that column.</p>
      </section>
      <section id="visual-history" class="evidence">
        <h3>5. Recent frames in the model input can increase performance</h3>
        <p>Recent frames show how the scene moved during the latency. The best format for these frames is different for each task.</p>
        <HistoryFigure />
      </section>
    </div>
  </section>

  <section id="citation" class="paper-section section-width citation-section">
    <div class="citation-heading"><h2>Citation</h2><button type="button" id="copy-citation">Copy BibTeX</button></div>
    <pre><code id="citation-text">{citation}</code></pre>
  </section>
</Layout>
<script>import '../../lagen/scripts/interactions';</script>
